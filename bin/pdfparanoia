#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
pdfparanoia - pdf watermark removal tool

This is the command-line client. It accepts pdf formatted data either through
stdin/piping or by referencing a file in argv[0].
"""


if __name__ == "__main__":
    import sys
    import pdfparanoia
    import argparse

    try:
        from StringIO import StringIO
        BytesIO = StringIO  # Python 2: str == bytes
    except ImportError:
        from io import BytesIO  # Python 3

    ArgP = argparse.ArgumentParser(description="pdfparanoia is a PDF watermark removal library for academic papers. Some publishers include private information like institution names, personal names, ip addresses, timestamps and other identifying information in watermarks on each page.")
    ArgP.add_argument('in_pdf', nargs='?', type=argparse.FileType('rb'),
                        default='-') # argparse.FileType interprets "-" as Stdin.
    ArgP.add_argument("-o", "--output", default=None, metavar="FILE",
                      help="Output file path.  Defaults to stdout.  "
                           "Safe to use the same path as the input file.")
    ArgP.add_argument("-v", "--verbose", action="store_true", default=False,
                      help="Output more information, which may be sensitive or excessive.")
    ArgP.add_argument("-V", "--more-verbose", action="store_true", default=False,
                      help="Output even more information. Implies -v.")
    ArgP.add_argument("-s", "--scrub-strings", action="append", default=[],
                      metavar="STRING",
                      help="Additional literal string to remove from all FlateDecode streams. "
                           "May be specified multiple times.  Matching is case-insensitive "
                           "unless --case-sensitive is also given.")
    ArgP.add_argument("--case-sensitive", action="store_true", default=False,
                      help="Make --scrub-strings matching case-sensitive (default: case-insensitive).")
    Args = ArgP.parse_args()

    verbose = 0
    if Args.verbose: verbose = 1
    if Args.more_verbose: verbose = 2

    # Wrap the raw bytes in a BytesIO so pdfparanoia.scrub() can seek it.
    # (In Python 2 str==bytes so StringIO works; in Python 3 we need BytesIO.)
    raw = Args.in_pdf.read()
    Args.in_pdf.close()
    try:
        fh = BytesIO(raw)
    except Exception:
        fh = StringIO(raw)

    outputcontent = pdfparanoia.scrub(fh, verbose=verbose,
                                      scrub_strings=Args.scrub_strings or None,
                                      scrub_strings_case_sensitive=Args.case_sensitive)

    # Open the output only after the input has been fully read and processed,
    # so that -o /same/file as input is safe (no premature truncation).
    if Args.output is None:
        out_fh = getattr(sys.stdout, 'buffer', sys.stdout)
        out_fh.write(outputcontent)
    else:
        with open(Args.output, 'wb') as out_fh:
            out_fh.write(outputcontent)

